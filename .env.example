# ============================================================================
# FitControl environment configuration (EXAMPLE — no real secrets here).
# Copy to `.env` and fill in real values. NEVER commit your real .env.
# ============================================================================

# --- Runtime ---
# development | production. In production DEV_AUTH_MODE is force-disabled.
ENVIRONMENT=development

# --- Database ---
# Used by the API/bot (async driver). Alembic normalizes it to a sync driver.
DATABASE_URL=postgresql+asyncpg://fitcontrol:fitcontrol@db:5432/fitcontrol
# Individual parts consumed by the Postgres container in docker-compose:
POSTGRES_USER=fitcontrol
POSTGRES_PASSWORD=fitcontrol
POSTGRES_DB=fitcontrol

# --- Telegram ---
# Bot token from @BotFather. REQUIRED for the bot and initData validation.
TELEGRAM_BOT_TOKEN=
# Public HTTPS URL where the Mini App is served (BotFather Web App URL).
# e.g. https://your-tunnel.trycloudflare.com
WEBAPP_URL=
# Max accepted age of Telegram initData (seconds).
INITDATA_MAX_AGE_SECONDS=86400

# --- Auth / security ---
# DEV ONLY. Allows the X-Dev-Telegram-Id header to bypass initData validation.
# MUST stay false in production (also force-disabled when ENVIRONMENT=production).
DEV_AUTH_MODE=false
# Comma-separated allowed CORS origins. Use your Mini App origin in production.
# "*" is only acceptable for local development.
CORS_ORIGINS=*

# --- Notifications / scheduler ---
DEFAULT_TIMEZONE=Asia/Tashkent
# Run the notification scheduler as a separate compose service (recommended).
ENABLE_SCHEDULER=false
DAILY_SUMMARY_HOUR=9
EXPIRY_REMINDER_DAYS=3

# --- Mini App build-time ---
# Full backend API base URL for production builds (leave empty to use /api/v1).
VITE_API_BASE=
# DEV ONLY: pretend to be this Telegram ID when running outside Telegram.
VITE_DEV_TELEGRAM_ID=
